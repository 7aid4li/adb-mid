{
  "manifest_version": 3,
  "name": "Postcrossing Tab Sorter",
  "version": "1.0",
  "description": "Sorts open browser tabs based on Postcrossing IDs found in their titles.",
  
  "permissions": [
    "tabs"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}

